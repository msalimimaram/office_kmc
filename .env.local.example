# Local development only. Do not use these values in production.
DJANGO_SECRET_KEY=local-development-secret-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset to use the local SQLite database (db.sqlite3).
# For PostgreSQL integration testing, uncomment and use the local Docker service:
# DATABASE_URL=postgresql://office_kmc:office_kmc@127.0.0.1:5432/office_kmc
DB_SSLMODE=prefer
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_AGE=1800
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
# DEBUG=True uses the process-local cache; Redis is not required for local smoke tests.
REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_TRUST_PROXY_SSL_HEADER=False
