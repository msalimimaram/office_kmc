# Local development only. Do not use these values in production.
DJANGO_SECRET_KEY=local-development-secret-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://office_kmc:office_kmc@127.0.0.1:5432/office_kmc
DB_SSLMODE=prefer
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_AGE=1800
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
