[Unit]
Description=Apply due insurance contract revisions and lifecycle dates
After=network.target postgresql.service

[Service]
Type=oneshot
User=office-kmc
Group=office-kmc
WorkingDirectory=/srv/office_kmc
EnvironmentFile=/etc/office-kmc.env
ExecStart=/srv/office_kmc/.venv/bin/python manage.py apply_due_contract_revisions
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/office_kmc/private_media
