# Production example. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=insurance.example.com
DATABASE_URL=postgresql://app_user:strong-password@db.example.internal:5432/insurance_db
DB_SSLMODE=require
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_AGE=1800
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
