# Production example. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=insurance.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://insurance.example.com
DATABASE_URL=postgresql://app_user:strong-password@db.example.internal:5432/insurance_db
DB_SSLMODE=require
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_AGE=1800
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Shared cache for login throttling across application workers
REDIS_URL=redis://redis.internal:6379/0
DJANGO_TRUST_PROXY_SSL_HEADER=True

# Required in production: ClamAV TCP service reachable only from the app network
CLAMD_HOST=clamav.internal
CLAMD_PORT=3310
CLAMD_TIMEOUT=10
